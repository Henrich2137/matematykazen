{
  "name": "matematykazen-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  //"postCreateCommand": "npm install",
  //bez sensu bo mozna overwrite "postCreateCommand": "chmod 555 /workspace/.devcontainer/init-firewall.sh; chmod 555 /workspace/.devcontainer/devcontainer.json; chmod 555 /workspace/.devcontainer/Dockerfile; ",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "remoteUser": "node",
  "mounts": [
    "source=matematykazen-claude-config-${devcontainerId},target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ]
    }
  }
}
