{
  "name": "matematykazen-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // ZERO uprawnień dla kontenera — także NET_ADMIN. To jest celowe: podman
  // wkłada dodane capabilities do zestawu ambient również zwykłemu userowi,
  // więc kontener z NET_ADMIN mógłby rozbroić własny firewall (`iptables -F`)
  // bez żadnego sudo. Firewall nakłada więc HOST, przez
  // .devcontainer/host-firewall.sh (patrz initializeCommand niżej).
  // Efekt uboczny: `sudo` w kontenerze nie działa (brak SETUID/SETGID) —
  // instalacja pakietów idzie przez Dockerfile i przebudowę obrazu.
  //
  // ŚWIADOMIE NIE MA TU --userns=keep-id (flaga wyłącznie podmanowa; Docker
  // odrzuca ją błędem, a config ma działać też na Kubuntu z Docker Engine).
  // Pod podmanem rozszerzenie Dev Containers dokłada `--userns=keep-id`
  // i `--security-opt label=disable` samo, gdy remoteUser != root.
  "runArgs": [
    "--cap-drop=ALL"
  ],
  "remoteUser": "node",
  // false, bo pod keep-id uid node (1000) ma się zgadzać z uid hosta (1000).
  "updateRemoteUserUID": false,

  // Bez własnego workspaceMount repo montuje się pod domyślną ścieżką
  // /workspaces/${localWorkspaceFolderBasename} — workspaceFolder musi ją
  // powtarzać, inaczej VS Code otwiera pusty katalog.
  "workspaceFolder": "/workspaces/matematykazen",
  "mounts": [
    "source=matematykazen-claude-config,target=/home/node/.claude,type=volume",

    // Logowanie `gh` przeżywa przebudowę obrazu. Bez tego ~/.config/gh leży w
    // warstwie zapisywalnej kontenera i ginie przy każdym rebuildzie, więc
    // `gh auth login` trzeba by powtarzać w kółko.
    //
    // Dlaczego wolumen, a nie bind hostowego ~/.config/gh: na hoście `gh`
    // trzyma token w KEYRINGU, a hosts.yml zawiera samą nazwę użytkownika —
    // podmontowanie go dałoby w kontenerze usera bez tokenu, czyli nic.
    //
    // Uwaga: w kontenerze nie ma keyringu, więc token leży tu plaintextem.
    // To nie jest regres — dotąd leżał plaintextem dokładnie tak samo, tyle że
    // w efemerycznej warstwie kontenera.
    //
    // Czego to NIE dotyczy: `git push`/`pull` działa niezależnie od `gh`, bo
    // Dev Containers wstrzykuje do ~/.gitconfig własny credential helper
    // pytający hosta przez socket. Copilot w VS Code też nie wymaga logowania
    // po rebuildzie — jego sesja żyje po stronie hosta, nie w kontenerze.
    "source=matematykazen-gh-config,target=/home/node/.config/gh,type=volume",

    // .devcontainer TYLKO DO ODCZYTU — nakłada się na zamontowane repo i
    // przykrywa ten katalog. Bez tego kontener mógłby podmienić własną
    // konfigurację, a `host-firewall.sh` wykonuje się NA HOŚCIE jako Ty:
    // podmieniony = dowolny kod poza izolacją przy następnym otwarciu
    // kontenera. Pliki nadal się czytają i uruchamiają, nie da się ich tylko
    // zapisać. Konsekwencja: zmiany w .devcontainer robisz z hosta, a operacje
    // gita, które dotykają tego katalogu (checkout innej gałęzi, pull), nie
    // przejdą z wnętrza kontenera.
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspaces/matematykazen/.devcontainer,type=bind,readonly",

    // .vscode TYLKO DO ODCZYTU — z tego samego powodu co .devcontainer wyżej,
    // tylko wektor jest inny i mniej oczywisty: tutejszy tasks.json ma zadanie
    // z "runOn": "folderOpen", czyli polecenie powłoki, które VS Code odpala
    // SAM, bez pytania, przy każdym otwarciu tego folderu. Kontener mógłby
    // podmienić `git pull --ff-only` na dowolną komendę i po prostu poczekać.
    // Odpali się ona tam, gdzie folder zostanie otwarty — a więc na hoście,
    // poza całą izolacją, gdy otworzysz repo lokalnie zamiast w kontenerze.
    // settings.json jest drugim, słabszym wektorem (choćby ścieżki do podmana).
    //
    // Konsekwencje identyczne jak przy .devcontainer: zmiany w .vscode robisz
    // z hosta, a `checkout`/`pull` ruszający ten katalog przerwie się w połowie
    // i trzeba go dokończyć z hosta (`git checkout -- .vscode`).
    "source=${localWorkspaceFolder}/.vscode,target=/workspaces/matematykazen/.vscode,type=bind,readonly",

    // Chromium dla Playwrighta — do oglądania własnych zmian w CSS zrzutami
    // ekranu (patrz issues/playwright-podglad.md).
    //
    // Bind z hosta, a nie wolumen, bo wolumen trzeba by czymś wypełnić, a
    // pobranie przeglądarki wymaga sieci: firewall blokuje cdn.playwright.dev
    // i storage.googleapis.com, a dopisanie ich do allowlisty odpadło — to
    // anycast Cloudflare/Azure, czyli dokładnie ten problem, dla którego
    // świadomie odrzucono formspree.io (komentarz w init-firewall.sh).
    // Przeglądarkę pobiera się więc raz na hoście, do ~/.cache/ms-playwright.
    //
    // readonly, bo Playwright w trakcie działania tylko czyta binarki — a
    // kontener nie ma po co móc podmienić pliku wykonywalnego, który sam
    // uruchamia.
    //
    // ${localEnv:HOME}, bo ${localWorkspaceFolder} wskazuje repo, a ten katalog
    // leży poza nim (celowo — 650 MB binarek nie ma prawa trafić do gita).
    //
    // UWAGA: wersja pakietu `playwright` instalowana w Dockerfile musi być
    // DOKŁADNIE ta, którą pobrano tutaj — biblioteka żąda konkretnego builda
    // przeglądarki i przy rozjeździe odmawia startu.
    "source=${localEnv:HOME}/.cache/ms-playwright,target=/home/node/.cache/ms-playwright,type=bind,readonly"
  ],

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    // Bez tego Playwright szuka przeglądarek pod swoją domyślną ścieżką i
    // nie zobaczy tej podmontowanej wyżej.
    "PLAYWRIGHT_BROWSERS_PATH": "/home/node/.cache/ms-playwright"
  },
  // Wykonuje się NA HOŚCIE, zanim powstanie kontener. Odpala obserwatora w tle:
  // poczeka, aż kontener wstanie, i nałoży na niego firewall z zewnątrz.
  // Wołane SYNCHRONICZNIE (bez `&`): tryb --spawn oddaje obserwatora systemd-owi
  // i wraca w kilkadziesiąt ms. Warianty z `nohup &` i `setsid &` zawiodły — VS
  // Code sprzątał proces w tle, zanim ten zdążył cokolwiek zrobić. Jednostka
  // systemd żyje we własnym cgroupie, poza drzewem procesów VS Code.
  // Przekierowanie wyjścia łapie błędy, które padłyby przed pierwszym logiem.
  "initializeCommand": "bash ${localWorkspaceFolder}/.devcontainer/host-firewall.sh --spawn >>/tmp/matematykazen-firewall-spawn.log 2>&1 || true",

  // Wykonuje się w kontenerze. Nie nakłada już firewalla (nie ma czym) — czeka
  // na niego i przerywa start sesji, jeśli się nie pojawi. Fail-closed: lepiej
  // nie wejść do kontenera, niż wejść do niego bez ochrony.
  "postStartCommand": "bash .devcontainer/verify-firewall.sh",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        // Podglad KaTeX-a w plikach .md. Uwaga: exercises.json to nie
        // markdown, wiec wzorow z arkuszy tym nie podejrzysz — to jest pod
        // ARCHITECTURE.md i transkrypt tablicy wzorow.
        "goessner.mdmath",
        // Serwer statyczny. Od migracji na exercises.json strona laduje dane
        // fetchem, ktory nie dziala po file:// — bez serwera arkusz sie nie
        // otworzy. VS Code sam przekieruje port na hosta.
        "ritwickdey.LiveServer"
      ]
    }
  }
}