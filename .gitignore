# Cache Manima (Tex/SVG, klatki, wideo pośrednie) — w całości odtwarzalny
# z plików .py w manimations/, nie ma po co siedzieć w historii repo.
# To samo mówi manimations/.gitignore; wpis jest tu powtórzony celowo, żeby
# reguła była widoczna w jednym, oczywistym miejscu dla całego repo.
manimations/media/

# Osobista konfiguracja Claude Code (np. pluginy włączone tylko lokalnie
# przez /plugin, scope project) — w odróżnieniu od .claude/settings.json,
# który jedzie z repo (np. superpowers).
.claude/settings.local.json

# Robocze pliki wranglera (narzędzie Cloudflare). Powstają lokalnie przy
# `wrangler deploy --dry-run` i przy podglądzie, nie mają nic wspólnego z treścią
# strony. Konfiguracja hostingu (wrangler.jsonc, .assetsignore, _headers) JEST
# w repo, patrz issues/cloudflare-hosting.md.
.wrangler/
node_modules/

# Ustawienia widoku katalogu z Dolphina (menedżer plików KDE): zapamiętany
# sposób sortowania, ikona folderu i podobne drobiazgi. Powstaje po cichu przy
# klikaniu w folderze, jest osobisty i nie ma nic wspólnego z treścią strony.
# Bez ukośnika, więc reguła łapie ten plik w każdym podkatalogu, nie tylko
# w korzeniu.
.directory
